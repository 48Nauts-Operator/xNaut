<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements. Notarized builds run under the hardened
     runtime (codesign flag 0x10000); without the audio-input entitlement macOS
     denies the microphone with NO prompt and NO error, so dictation captured
     silence and the model wrote "you" (XNAUT-187). NSMicrophoneUsageDescription
     in Info.plist supplies the prompt text; this grants the capability. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
