<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the bundle by Tauri on macOS. Without the microphone key, TCC
     denies the mic with no prompt and no error: dictation would look broken
     rather than blocked (XNAUT-187). -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>xNAUT uses the microphone for dictation and voice conversations. Public voice sends audio to your configured voice provider, including in speech-to-text mode.</string>
</dict>
</plist>
