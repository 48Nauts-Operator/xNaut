{
  "name": "xnaut-frontend",
  "private": true,
  "scripts": {
    "build:monaco": "node scripts/build-monaco.mjs",
    "build:loops": "esbuild frontend/loops-editor-entry.js --bundle --minify --format=iife --global-name=XnautRete --platform=browser --target=safari15 --alias:lit/decorators=lit/decorators.js --alias:lit/directives/style-map=lit/directives/style-map.js --outfile=src/js/vendor/loops-editor.bundle.js",
    "build": "npm run build:monaco && npm run build:loops",
    "serve": "node tests/static-server.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "lint": "eslint src/js",
    "test:smoke": "playwright test console-clean",
    "test:commands": "node tests/commands-dropdown.mjs",
    "test:hygiene": "node scripts/hygiene-check.mjs",
    "test:all": "cargo test --manifest-path src-tauri/Cargo.toml && node scripts/hygiene-check.mjs && playwright test"
  },
  "dependencies": {
    "lit": "2.8.0",
    "monaco-editor": "0.56.0",
    "rete": "2.0.6",
    "rete-area-plugin": "2.3.2",
    "rete-connection-plugin": "2.0.5",
    "rete-lit-plugin": "2.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "simple-icons": "^16.28.0"
  }
}
